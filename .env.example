# Kashing News Aggregator - Environment Variables
# Copy this file to .env.local and fill in your API keys

# Alpha Vantage API Key (Free: https://www.alphavantage.co/support/#api-key)
# Free tier: 5 requests/minute, 500 requests/day
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Financial Modeling Prep API Key (Free: https://financialmodelingprep.com/developer/docs/)
# Free tier: 250 requests/day
FMP_API_KEY=your_fmp_key_here

# Optional: NewsAPI Key for additional news sources
# NEWSAPI_KEY=your_newsapi_key_here
